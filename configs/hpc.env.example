# Copy to a local, ignored .env file or export before an HPC job.
# Never put an SJSU ID, password, token, or an actual personal path in Git.

# Cloned repositories in your personal course directory. Do not commit the
# copied file after replacing these placeholders.
export PROJECT_ROOT=<absolute-path-to-this-repository>
export UPSTREAM_ROOT=<absolute-path-to-DeepDataMiningLearning>

# Shared course data are read-only. All generated files belong in your own
# student workspace, never in the shared dataset tree.
export PROJECT_DATA_ROOT=/data/cmpe249-fa26
export PROJECT_SCRATCH_ROOT=<absolute-path-to-your-student-folder>/scratch
export PROJECT_CACHE_ROOT=<absolute-path-to-your-student-folder>/cache

# Build this environment once with the course Python and system site packages:
# /data/cmpe249-fa26/envs/mmdet3d-cu118/bin/python -m venv --system-site-packages <VENV_PATH>
export VENV_PATH=<absolute-path-to-your-student-folder>/venv

# Leave unset unless a package specifically needs nvcc. The shared PyTorch
# environment already supports the course GPU types.
export CUDA_MODULE=
