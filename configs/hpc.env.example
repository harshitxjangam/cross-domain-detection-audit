# Copy to a local, ignored .env file or export before an HPC job.
# Never put an SJSU ID, password, token, or an actual personal path in Git.

# Course group directories: confirm the current-term values after login.
PROJECT_DATA_ROOT=/data/<course-group>/<project>
PROJECT_SCRATCH_ROOT=/scratch/<course-group>/<project>
PROJECT_CACHE_ROOT=/data/<course-group>/<project>/cache

# The guide lists examples such as gpuqs/nsfqs. Verify availability with
# `sinfo` and select the appropriate allocated GPU partition.
SLURM_PARTITION=<gpu-partition>
SLURM_ACCOUNT=<if-required>
CONDA_ENV=<environment-name>
CUDA_MODULE=<cuda-module-name>
